# ==============================================================================
# TravelMind Environment Variables
# Copy to .env for local development: cp .env.example .env
# NEVER commit .env to version control!
# ==============================================================================

# ----- Django Backend Settings -----
# In production, generate a secure random 50+ character key.
SECRET_KEY=insecure-dev-key-change-in-production-min-50-characters-long

# Set to True for local development, False for production.
DEBUG=True

# Comma-separated list of allowed hostnames/IPs
ALLOWED_HOSTS=127.0.0.1,localhost

# ----- Database (PostgreSQL) -----
# Format: postgres://USER:PASSWORD@HOST:PORT/DB_NAME
# Local docker-compose default:
DATABASE_URL=postgres://travelmind_user:travelmind_password_dev_only@127.0.0.1:5432/travelmind
# Offline / Fallback SQLite (for testing or local dev without PostgreSQL):
# DATABASE_URL=sqlite:///db.sqlite3

# ----- Redis & Caching -----
# Redis database 1 for application cache
REDIS_URL=redis://127.0.0.1:6379/1
# Set to True to use Django in-memory cache if Redis is not installed locally
USE_LOCAL_CACHE=False

# ----- Celery Task Queue -----
# Redis database 0 for Celery message broker & result backend
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# ----- Security & SSL -----
# Set to True in production with valid HTTPS certificate
SECURE_SSL_REDIRECT=False

# ----- CORS (Cross-Origin Resource Sharing) -----
# Comma-separated allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ----- Frontend (Vite) -----
# Base URL for API client requests
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
